{
  "name": "dahenfeld",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "prepare": "cypress install",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint .",
    "fix-lint": "eslint . --fix",
    "format": "prettier --write src/",
    "format:check:ci": "npx prettier --check src"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/device": "^8.0.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.1",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/status-bar": "8.0.3",
    "@capawesome/capacitor-android-edge-to-edge-support": "^8.0.8",
    "@globalhive/vuejs-tour": "^3.0.1",
    "@ionic/vue": "^9.0.2",
    "@ionic/vue-router": "^9.0.2",
    "dotenv": "^17.4.2",
    "firebase": "^12.18.0",
    "lg-thumbnail": "^1.2.1",
    "lg-zoom": "^1.3.0",
    "lightgallery": "^2.9.0",
    "ol": "^10.10.0",
    "ol-contextmenu": "^6.0.1",
    "ol-ext": "^4.0.38",
    "pinia": "^4.0.3",
    "swiper": "^14.2.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "vue3-google-map": "^0.27.2",
    "vue3-openlayers": "^12.2.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/cli-service": "5.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "cypress": "^16.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-cypress": "^7.0.1",
    "eslint-plugin-vue": "~10.10.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.6",
    "sass-embedded": "^1.103.1",
    "start-server-and-test": "^3.0.12",
    "typescript": "~5.8.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
