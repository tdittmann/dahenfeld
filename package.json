{
  "name": "dahenfeld",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "prepare": "cypress install",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint .",
    "fix-lint": "eslint . --fix",
    "format": "prettier --write src/",
    "format:check:ci": "npx prettier --check src"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.1",
    "@capacitor/app": "8.0.0",
    "@capacitor/core": "8.0.1",
    "@capacitor/device": "^8.0.0",
    "@capacitor/haptics": "8.0.0",
    "@capacitor/ios": "8.0.1",
    "@capacitor/keyboard": "8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/status-bar": "8.0.0",
    "@capawesome/capacitor-android-edge-to-edge-support": "^8.0.3",
    "@globalhive/vuejs-tour": "^2.6.2",
    "@ionic/vue": "^8.7.17",
    "@ionic/vue-router": "^8.7.17",
    "dotenv": "^17.2.3",
    "firebase": "^12.8.0",
    "ol": "^10.7.0",
    "ol-contextmenu": "^6.0.0",
    "ol-ext": "^4.0.37",
    "pinia": "^3.0.4",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4",
    "vue3-google-map": "^0.27.0",
    "vue3-openlayers": "^12.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.0.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.0.10",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/eslint-plugin": "^1.6.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "cypress": "^15.9.0",
    "eslint": "^9.39.2",
    "eslint-plugin-cypress": "^5.2.1",
    "eslint-plugin-vue": "~10.7.0",
    "jiti": "^2.6.1",
    "jsdom": "^27.4.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.8.1",
    "sass-embedded": "^1.97.3",
    "start-server-and-test": "^2.1.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.4"
  }
}
