{
  "name": "dahenfeld",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "prepare": "cypress install",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint .",
    "fix-lint": "eslint . --fix",
    "format": "prettier --write src/",
    "format:check:ci": "npx prettier --check src"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.4.4",
    "@capacitor/device": "^7.0.2",
    "@capacitor/push-notifications": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3",
    "@capawesome/capacitor-android-edge-to-edge-support": "^7.2.3",
    "@globalhive/vuejs-tour": "^2.5.0",
    "@ionic/vue": "^8.7.9",
    "@ionic/vue-router": "^8.7.9",
    "dotenv": "^17.2.3",
    "firebase": "^12.5.0",
    "ol": "^10.7.0",
    "ol-contextmenu": "^5.5.0",
    "ol-ext": "^4.0.36",
    "pinia": "^3.0.4",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3",
    "vue3-google-map": "^0.25.1",
    "vue3-openlayers": "^12.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/eslint-plugin": "^1.4.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "cypress": "^15.6.0",
    "eslint": "^9.39.1",
    "eslint-plugin-cypress": "^5.2.0",
    "eslint-plugin-vue": "~10.5.1",
    "jiti": "^2.6.1",
    "jsdom": "^27.1.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.6.2",
    "sass-embedded": "^1.93.3",
    "start-server-and-test": "^2.1.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-pwa": "^1.1.0",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vitest": "^4.0.8",
    "vue-tsc": "^3.1.3"
  }
}
